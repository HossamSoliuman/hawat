APP_NAME="حوات"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://hawat.test

# مضيفا المنتجين (config/hawat.php): النطاق الرئيسي من APP_URL، وبوابات الوزارة
# على gov.<النطاق الرئيسي>. لا يُضبطان إلا إذا اختلفا عن ذلك.
# APP_DOMAIN=hawat.test
# GOV_DOMAIN=gov.hawat.test
APP_TIMEZONE=Asia/Riyadh
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# كلمة مرور حسابات البذر لبوابة المعلومات (UserSeeder). بيانات تهيئة لا إنتاج:
# غيّرها على الخادم قبل التسليم. الافتراضية hawat@2026 حين تُترك فارغة.
# SEED_PASSWORD=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hawat
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@hawat.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
